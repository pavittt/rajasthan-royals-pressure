 t = sit_all.copy(); t[\"view\"] = v; t[\"col\"] = \"All\"; G = pd.concat([G, t])\nG.loc[G.grid == \"role_phase\", \"col\"] = \"All\"\nG = G[G.grid != \"situation\"]\nG[\"rr_wins\"] = G.rr_raw_wins; G[\"rr_wins_shrunk\"] = G.rr_wins\nkeep = [\"side\", \"view\", \"row\", \"col\", \"phase\", \"rr_balls\", \"league_balls\", \"rr_wins\", \"champ_wins\", \"p_rr_below\", \"luck_p\", \"verdict\",\n        \"rr_sr\", \"ch_sr\", \"lg_sr\", \"rr_bpd\", \"ch_bpd\", \"lg_bpd\", \"rr_econ\", \"ch_econ\", \"lg_econ\", \"rr_bpw\", \"ch_bpw\", \"lg_bpw\"]\nG = G.drop(columns=[\"rr_wins\"]).rename(columns={\"rr_raw_wins\": \"rr_wins\"})\nG[\"p_rr_below\"] = (100 * G.p_rr_below).round(0); G[\"luck_p\"] = (100 * G.luck_p).round(1)\ndump(\"grid\", G[keep].round(3), \"grid_all.csv (s25_grid.py): IPL 2022-26; RR = 2025-26\")\nP = pd.read_csv(W / \"gaps.csv\")\nbat = P.side == \"Batting\"\nP[\"stat1_label\"] = np.where(bat, \"Strike rate\", \"Economy\"); P[\"stat2_label\"] = np.where(bat, \"Balls per dismissal\", \"Balls per wicket\")\nfor p in (\"rr\", \"ch\", \"lg\"):\n    P[p + \"_stat1\"] = np.where(bat, P[p + \"_sr\"], P[p + \"_econ\"]); P[p + \"_stat2\"] = np.where(bat, P[p + \"_bpd\"], P[p + \"_bpw\"])\nP[\"confidence_pct\"] = P.rr_below_pct\ndump(\"gaps\", P[[\"rank\", \"id\", \"side\", \"gap\", \"points_to\", \"rr_balls\", \"rr_wins_lost\", \"confidence_pct\", \"plain_numbers_agree\", \"title_relevant\",\n                \"champ_wins_gained\", \"champ_luck_pct\", \"stat1_label\", \"rr_stat1\", \"ch_stat1\", \"lg_stat1\", \"stat2_label\", \"rr_stat2\", \"ch_stat2\", \"lg_stat2\"]],\n     \"gaps.csv (s27_players.py)\")\ndump(\"gap_players\", pd.read_csv(W / \"gap_players.csv\"), \"gap_players.csv (s27_players.py): IPL 2023-26, any team\")\ndump(\"gap_types\", pd.read_csv(W / \"gap_types.csv\"), \"gap_types.csv (s27_players.py): IPL 2022-26, every team\")\nT = pd.read_csv(W / \"tree_rules.csv\"); T[\"side\"] = T.side.str.capitalize(); T[\"rr_wins_lost\"] = (-T.rr_wins_lost_per_season).round(2)\nT[\"luck_pct\"] = (100 * T.luck_p_selection_aware).round(0); T[\"champ_wins\"] = T.champ_wins_per_season.round(2)\ndump(\"tree_rules\", T[[\"side\", \"rule\", \"rr_balls\", \"rr_wins_lost\", \"luck_pct\", \"half_sample_negative_pct\", \"champ_wins\"]], \"tree_rules.csv (s26_tree.py)\")\ndump(\"rr_bat_matrix\", pd.read_csv(W / \"rr_bat_matrix.csv\"), \"rr_bat_matrix.csv (s27_players.py): IPL 2023-26, any team\")\ndump(\"rr_bowl_matrix\", pd.read_csv(W / \"rr_bowl_matrix.csv\"), \"rr_bowl_matrix.csv (s27_players.py): IPL 2023-26, any team\")\n", "type": "code", "lang": "python"}, {"label": "Input", "value": "gap_players.csv (s27_players.py): IPL 2023-26, any team"}]}