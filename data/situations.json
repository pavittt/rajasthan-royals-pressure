ue2": 23.4, "rr_wins_lost": 0.08, "rr_balls": 40}, {"id": "W23", "side": "Bowling", "area": "Middle overs (7-15)", "situation": "Overs 7\u201310, new batter (first 6 balls), close game", "measure": "Economy", "rr": 6.8, "champions": 6.1, "league": 6.3, "measure2": "Balls per wicket", "rr2": 35.5, "champions2": 28.7, "league2": 32.6, "rr_wins_lost": 0.07, "rr_balls": 75}, {"id": "W24", "side": "Bowling", "area": "Middle overs (7-15)", "situation": "No. 3\u20134, left-hander v Leg-spin, Middle (7\u201315)", "measure": "Economy", "rr": 11.6, "champions": 9.2, "league": 9.0, "measure2": "Balls per wicket", "rr2": 16.8, "champions2": 56.0, "league2": 27.1, "rr_wins_lost": 0.06, "rr_balls": 67}, {"id": "W18", "side": "Bowling", "area": "Other", "situation": "New batter (first 6 balls), v Off-spin", "measure": "Economy", "rr": 7.1, "champions": 6.0, "league": 6.7, "measure2": "Balls per wicket", "rr2": 95.0, "champions2": 24.6, "league2": 28.1, "rr_wins_lost": 0.15, "rr_balls": 95}, {"id": "W14", "side": "Bowling", "area": "Powerplay / new ball", "situation": "Openers, right-hander v Right-arm pace, Powerplay (1\u20136)", "measure": "Economy", "rr": 10.2, "champions": 8.7, "league": 9.2, "measure2": "Balls per wicket", "rr2": 30.6, "champions2": 18.0, "league2": 22.4, "rr_wins_lost": 0.21, "rr_balls": 306}], "meta": [{"label": "s45_explain.py", "value": "\"\"\"Datasets for the dashboard's plain-words walkthrough.\nsituations : all 48 pressure moments with a plain-words label; RR 2025-26 v champions (IPL winners 2022-26) v league\narea_fix   : each area of RR's moments (each ball counted once, in its biggest-gap moment), 2025-26:\n             league, champions (RCB, winners 2025 and 2026), RR, and every final List 1 target with 15+ balls there\"\"\"\nimport pandas as pd, numpy as np, json, pathlib, re\nW = pathlib.Path(\"/home/claude/work\"); O = pathlib.Path(\"/home/claude/dash14\"); O.mkdir(exist_ok=True); CODE = pathlib.Path(__file__).read_text()\nA = pd.read_csv(W / \"all_moments.csv\")\nREP = [(r\"Close game \\(win chance 30-70%\\)\", \"Close game (win chance 30\u201370%)\"), (r\"Bowler hit for 20\\+ in last 12 balls\", \"After a bowler is hit for 20+\"),\n       (r\"game in the balance\", \"close game\"), (r\"game tilted\", \"game tilted to one side\"), (r\"stock ball\", \"normal balls\"),\n       (r\"new batter \\(first 6 balls\\)\", \"new batter (first 6 balls)\"), (r\"New batter: first 6 balls\", \"New batter (first 6 balls)\"),\n       (r\"^overs\", \"Overs\"), (r\"(\\d+)-(\\d+)\", r\"\\1\u2013\\2\")]\ndef plain(s):\n    parts = [p.strip() for p in s.split(\"|\")]\n    out = []\n    for p in parts:\n        for a, b in REP: p = re.sub(a, b, p)\n        if re.fullmatch(r\"(v )?(Right-arm pace|Left-arm pace|Off-spin|Leg-spin|Left-arm finger spin|right-arm pace)\", p): p = \"v \" + p.removeprefix(\"v \")\n        out.append(p)\n    return \", \".join(out)\nS = pd.DataFrame({\"id\": A.id, \"side\": A.side.str.capitalize(), \"area\": A.theme.str.replace(r\"^(Batting|Bowling): \", \"\", regex=True).str.capitalize(),\n                  \"situation\": A.label.map(plain), \"measure\": A.stat, \"rr\": A.rr.round(1), \"champions\": A.champ.round(1), \"league\": A.league.round(1),\n                  \"measure2\": A.stat2, \"rr2\": A.rr2.round(1), \"champions2\": A.champ2.round(1), \"league2\": A.league2.round(1),\n                  \"rr_wins_lost\": A.rr_wins_lost.round(2), \"rr_balls\": A.rr_balls})\nS = S.sort_values([\"side\", \"area\", \"rr_wins_lost\"], ascending=[True, True, False])\nt = pd.read_csv(W / \"40666adb-teams.csv\"); rcb = set(t[t.team_name.str.contains(\"Royal Challengers\")].team_id)\nT = json.load(open(\"/home/claude/dash12/fix_top.json\"))[\"rows\"]\ntargets = {s: [(r[\"name\"], r[\"rank\"], r[\"band\"]) for r in T if r[\"list\"] == \"Can buy\" and r[\"side\"] == s.capitalize() and r[\"band\"] != \"Not proven by plain numbers\"] for s in (\"batting\", \"bowling\")}\nrows = []\nfor side in (\"batting\", \"bowling\"):\n    d = pd.read_parquet(W / f\"moment_balls_{side}.parquet\"); r, k = (\"runs\", \"out\") if side == \"batting\" else (\"brun\", \"wk\")\n    for th, q in d.groupby(\"theme\"):\n        def add(who, grp, x, rank=None, band=None):\n            if len(x) == 0: return\n            s1 = 100 * x[r].sum() / len(x) if side == \"batting\" else 6 * x[r].sum() / len(x)\n            rows.append({\"side\": side.capitalize(), \"area\": th, \"who\": who, \"group\": grp, \"list1_rank\": rank, \"verdict\": band, \"balls\": len(x),\n                         \"stat1_label\": \"Strike rate\" if side == \"batting\" else \"Economy\", \"stat1\": round(s1, 1),\n                         \"stat2_label\": \"Balls per dismissal\" if side == \"batting\" else \"Balls per wicket\", \"stat2\": round(len(x) / max(x[k].sum(), 1), 1)})\n        add(\"League\", \"League\", q); add(\"Champions (RCB 2025\u201326)\", \"Champions\", q[q.team.isin(rcb)]); add(\"RR 2025\u201326\", \"RR\", q[q.team == 3])\n        for n, rk, bd in targets[side]:\n            x = q[q.name == n]\n            if len(x) >= 15: add(n, \"Target\", x, rk, bd)\nF = pd.DataFrame(rows)\nlg = F[F.group == \"League\"].set_index(\"area\").stat1; F[\"better_than_league\"] = np.where(F.side == \"Batting\", F.stat1 > F.area.map(lg), F.stat1 < F.area.map(lg)).astype(object)\nF.loc[F.group == \"League\", \"better_than_league\"] = None\ndef dump(name, df, inputs):\n    rws = json.loads(df.replace({np.nan: None}).to_json(orient=\"records\"))\n    (O / f\"{name}.json\").write_text(json.dumps({\"rows\": rws, \"meta\": [{\"label\": \"s45_explain.py\", \"value\": CODE, \"type\": \"code\", \"lang\": \"python\"}, {\"label\": \"Input\", \"value\": inputs}]}))\n    print(name, len(rws))\ndump(\"situations\", S, \"all_moments.csv (s38)\"); dump(\"area_fix\", F, \"moment_balls_*.parquet (s38), fix_top.json (s42)\")\nprint(F.area.unique()); print(S.area.unique())\n", "type": "code", "lang": "python"}, {"label": "Input", "value": "all_moments.csv (s38)"}]}