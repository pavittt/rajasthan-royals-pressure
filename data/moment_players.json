, "key_label": "Economy"}], "meta": [{"label": "s29_moments_v2.py", "value": "\"\"\"Final pressure moments v2: keep B1-B3 and W1-W3 (s22), replace B4, B5, W4, W5 with the two bowling gaps the full\naudit (s25) confirmed: new W4 = left-handed No. 3-4 in overs 7-15, new W5 = right-arm pace to right-handed openers in\novers 1-6. Stats for the new two use s25's checks (champion luck draws, RR match resampling); plain numbers and player\nlists use the same rules as s22. Also writes the dashboard JSONs for moments, players and the step-2 top lists.\"\"\"\nimport pandas as pd, numpy as np, json, pathlib\nW = \"/home/claude/work/\"\nsrc = open(\"/home/claude/scripts/s25_grid.py\").read(); ns = {}; exec(src[:src.index(\"rows = []\")], ns)\nb, evaluate = ns[\"b\"], ns[\"evaluate\"]\nchamp = ns[\"champ\"]; b[\"bnd\"] = b.is_four | b.is_six\nM = pd.read_csv(W + \"final_moments.csv\"); PL = pd.read_csv(W + \"final_moment_players.csv\")\nM = M[M.id.isin([\"B1\", \"B2\", \"B3\", \"W1\", \"W2\", \"W3\"])]; PL = PL[PL.id.isin(M.id)]\nov = b.legal_before // 6\nNEW = [(\"W4\", \"Left-handed No. 3-4 in the middle overs\", \"Bowling to left-handed batters at No. 3-4 in overs 7-15.\",\n        \"A middle-overs bowler who troubles left-handers (off-spin or left-arm wrist spin)\", (ov.between(6, 14)) & (b.batting_order.between(3, 4)) & (b.batting_type == \"LHB\")),\n       (\"W5\", \"New ball to right-handed openers\", \"Right-arm pace bowling to right-handed openers in overs 1-6.\",\n        \"A new-ball pace bowler who takes early wickets\", (ov <= 5) & (b.batting_order <= 2) & (b.batting_type == \"RHB\") & (b.btype == \"Right-arm pace\"))]\ndef plain(s):\n    L = s[s.legal | s.is_wide | s.is_nb]; lb = L.legal.sum()\n    return {\"economy\": 6 * L.bowler_runs.sum() / lb, \"balls_per_wicket\": lb / max(L.bowler_wkt.sum(), 1), \"dot_pct\": 100 * L[L.legal].isdot.mean(), \"boundary_pct\": 100 * L[L.legal].bnd.mean(), \"balls\": int(lb)}\nRETIRED = {\"Ravichandran Ashwin\", \"Ajinkya Rahane\", \"Andre Russell\"}\nactive = set(b[b.year >= 2025].bowler_id)\nsq = pd.read_csv(W + \"squads2026.csv\"); RR26 = set(sq[sq.team_name == \"Rajasthan Royals\"].player_name)\nrows, players = [], []\nfor mid, short, desc, need, mask in NEW:\n    r = evaluate(mask, \"bowling\"); s = b[mask.values]\n    rr = s[(s.bowling_team_id == 3) & (s.year >= 2025)]; ch = s[[(y, t) in champ for y, t in zip(s.year, s.bowling_team_id)]]\n    row = {\"id\": mid, \"side\": \"Bowling\", \"moment\": short, \"definition\": desc, \"points_to\": need,\n           \"rr_wins_lost_per_season\": round(r[\"rr_raw_wins\"], 2), \"champ_wins_gained_per_season\": round(r[\"champ_wins\"], 2),\n           \"luck_chance_pct\": round(100 * r[\"luck_p\"], 1), \"rr_shortfall_real_pct\": round(100 * r[\"p_rr_below\"]), \"rr_balls\": int(r[\"rr_balls\"]),\n           \"balls_per_team_season\": int(round(r[\"bpy\"]))}\n    for pre, q in ((\"rr_\", rr), (\"champ_\", ch), (\"league_\", s)):\n        for k, v in plain(q).items():\n            if pre == \"rr_\" and k == \"balls\": continue\n            row[pre + k] = round(v, 1)\n    rows.append(row)\n    q = s[s.year >= 2023]\n    g = q.groupby(\"bowler_id\").agg(name=(\"bowler_name\", \"first\"), balls=(\"wpa\", \"size\"), wpa=(\"wpa\", \"sum\"))\n    g[\"value_per_10\"] = -10 * g.wpa / (g.balls + 40); g = g[g.index.isin(active) & ~g.name.isin(RETIRED)]\n    for kind, sub in ((\"best\", g[(g.balls >= 25) & (g.value_per_10 > 0)].sort_values(\"value_per_10\", ascending=False).head(8)), (\"rr\", g[g.name.isin(RR26)].sort_values(\"balls\", ascending=False).head(6))):\n        for p, pr in sub.iterrows():\n            pp = plain(q[q.bowler_id == p])\n            players.append({\"id\": mid, \"list\": \"Best in the league\" if kind == \"best\" else \"RR's 2026 squad\", \"name\": pr[\"name\"], \"balls\": int(pr.balls),\n                            \"value_per_10_balls\": round(pr.value_per_10, 2), \"key_stat\": round(pp[\"economy\"], 1), \"key_label\": \"Economy\"})\nM2 = pd.concat([M, pd.DataFrame(rows)], ignore_index=True); PL2 = pd.concat([PL, pd.DataFrame(players)], ignore_index=True)\nM2.to_csv(W + \"final_moments_v2.csv\", index=False); PL2.to_csv(W + \"final_moment_players_v2.csv\", index=False)\npd.set_option(\"display.width\", 300)\nprint(M2[[\"id\", \"moment\", \"rr_wins_lost_per_season\", \"champ_wins_gained_per_season\", \"luck_chance_pct\", \"rr_shortfall_real_pct\", \"rr_balls\", \"rr_economy\", \"champ_economy\", \"league_economy\", \"rr_balls_per_wicket\", \"league_balls_per_wicket\"]].to_string(index=False))\nprint(PL2[PL2.id.isin([\"W4\", \"W5\"])].to_string(index=False))\n# dashboard JSONs\nO = pathlib.Path(\"/home/claude/dash6\"); O.mkdir(exist_ok=True); CODE = pathlib.Path(__file__).read_text()\ndef dump(name, df, inputs):\n    rws = json.loads(df.replace({np.nan: None}).to_json(orient=\"records\"))\n    (O / f\"{name}.json\").write_text(json.dumps({\"rows\": rws, \"meta\": [{\"label\": \"s29_moments_v2.py\", \"value\": CODE, \"type\": \"code\", \"lang\": \"python\"}, {\"label\": \"Input\", \"value\": inputs}]}))\n    print(name, len(rws))\ndump(\"moments\", M2, \"final_moments_v2.csv (s22 for B1-B3, W1-W3; s25 checks for W4, W5)\")\ndump(\"moment_players\", PL2, \"final_moment_players_v2.csv: IPL 2023-26, any team\")\nEXCL = {\"Harry Brook\", \"Andre Russell\", \"Ajinkya Rahane\", \"Ravichandran Ashwin\"}\nfor kind in [\"bat\", \"bowl\"]:\n    n = pd.read_csv(W + f\"fin2_ratings_{kind}.csv\", index_col=0); n = n[(n.last_team != \"Pakistan\") & ~n.name.isin(EXCL)].copy(); n[\"rank\"] = np.arange(1, len(n) + 1)\n    n[\"top10_in_resamples_pct\"] = (100 * n.boot_top10).round(0); n[\"team\"] = n.ipl_team_latest.fillna(\"No IPL team\")\n    cols = [\"rank\", \"name\", \"team\", \"pb\", \"top10_in_resamples_pct\"] + ([\"SR_P\", \"SR_N\"] if kind == \"bat\" else [\"Econ_P\", \"Econ_N\"])\n    dump(f\"top_{kind}\", n[cols].head(15).round(1), f\"fin2_ratings_{kind}.csv (s30_unified_v2.py)\")\n", "type": "code", "lang": "python"}, {"label": "Input", "value": "final_moment_players_v2.csv: IPL 2023-26, any team"}]}