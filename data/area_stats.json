ng: powerplay / new ball", "who": "Gerald Coetzee", "group": "Target", "balls": 17, "stat1": 6.7, "stat2": 17.0, "stat1_label": "Economy", "stat2_label": "Balls per wicket"}, {"area": "Bowling: powerplay / new ball", "who": "Deepak Chahar", "group": "Target", "balls": 104, "stat1": 7.7, "stat2": 17.3, "stat1_label": "Economy", "stat2_label": "Balls per wicket"}], "meta": [{"label": "s43_verify.py", "value": "\"\"\"Verification tables for the final picks (2025-26):\narea_stats  : plain numbers in each area of RR's moments - league, champions (RCB), RR's current players, the new targets\ntype_phase  : IPL 2025-26 bowling by pace/spin and phase - RR v champions v league\nbat_types   : IPL 2025-26 batting by batter hand x bowler type - RR v champions v league\ntarget_spin : middle-overs batting v wrist spin / finger spin / pace for targets and RR's middle order (IPL + top-nine T20Is)\"\"\"\nimport pandas as pd, numpy as np, json, pathlib\nW = pathlib.Path(\"/home/claude/work\"); O = pathlib.Path(\"/home/claude/dash13\"); O.mkdir(exist_ok=True); CODE = pathlib.Path(__file__).read_text()\nsq = pd.read_csv(W / \"squads2027.csv\"); rr = set(sq[sq.team_name == \"Rajasthan Royals\"].player_id.dropna().astype(int))\nt = pd.read_csv(W / \"40666adb-teams.csv\"); rcb = set(t[t.team_name.str.contains(\"Royal Challengers\")].team_id)\nTB = [\"Rachin Ravindra\", \"Kusal Mendis\", \"Daryl Mitchell\", \"Shai Hope\"]\nTW = [\"Matheesha Pathirana\", \"Gerald Coetzee\", \"Mitchell Starc\", \"Deepak Chahar\", \"Mujeeb Ur Rahman\", \"Adil Rashid\", \"Adam Zampa\"]\nrows = []\nfor side, targets in ((\"batting\", TB), (\"bowling\", TW)):\n    d = pd.read_parquet(W / f\"moment_balls_{side}.parquet\")\n    for th, q in d.groupby(\"theme\"):\n        def f(x):\n            if side == \"batting\": return {\"balls\": len(x), \"stat1\": 100 * x.runs.sum() / len(x), \"stat2\": len(x) / max(x.out.sum(), 1)}\n            return {\"balls\": len(x), \"stat1\": 6 * x.brun.sum() / len(x), \"stat2\": len(x) / max(x.wk.sum(), 1)}\n        grp = [(\"League\", \"League\", q), (\"Champions (RCB)\", \"Champions\", q[q.team.isin(rcb)])]\n        grp += [(x.name.iat[0], \"RR now\", x) for _, x in q[q.pid.isin(rr)].groupby(\"pid\") if len(x) >= 15]\n        grp += [(n, \"Target\", q[q.name == n]) for n in targets if (q.name == n).sum() >= 15]\n        if sum(g == \"Target\" for _, g, _ in grp) == 0: continue\n        for nm, g, x in grp:\n            if len(x) == 0: continue\n            r = f(x); rows.append({\"area\": th, \"who\": nm, \"group\": g, \"balls\": r[\"balls\"], \"stat1\": round(r[\"stat1\"], 1), \"stat2\": round(r[\"stat2\"], 1),\n                                   \"stat1_label\": \"Strike rate\" if side == \"batting\" else \"Economy\", \"stat2_label\": \"Balls per dismissal\" if side == \"batting\" else \"Balls per wicket\"})\nA = pd.DataFrame(rows)\nb = pd.read_parquet(W / \"balls_pi.parquet\", columns=[\"fmt\", \"year\", \"bowling_type\", \"legal_before\", \"bowling_team_id\", \"batting_team_id\", \"bowler_runs\", \"bowler_wkt\", \"legal\", \"is_wide\", \"is_nb\",\n                                                      \"faced\", \"runs\", \"striker_out\", \"batting_type\", \"striker_name\"])\nip = b[(b.fmt == \"IPL\") & (b.year >= 2025)].copy(); bt = ip.bowling_type.fillna(\"\")\nip[\"type\"] = np.where(bt.str.contains(\"Leg|Chinaman|off|orthodox\", case=False), \"Spin\", \"Pace\")\nov = ip.legal_before // 6; ip[\"phase\"] = np.select([ov <= 5, ov <= 14], [\"Powerplay (1-6)\", \"Middle (7-15)\"], \"Death (16-20)\")\nL = ip[ip.legal | ip.is_wide | ip.is_nb].copy(); L[\"grp\"] = np.where(L.bowling_team_id == 3, \"RR\", np.where(L.bowling_team_id.isin(rcb), \"Champions (RCB)\", \"League\"))\nTP = L.groupby([\"type\", \"phase\", \"grp\"]).apply(lambda x: pd.Series({\"overs\": round(x.legal.sum() / 6), \"econ\": round(6 * x.bowler_runs.sum() / x.legal.sum(), 1),\n                                                                   \"balls_per_wkt\": round(x.legal.sum() / max(x.bowler_wkt.sum(), 1), 1)})).reset_index()\nfb = ip[ip.faced].copy(); fb[\"grp\"] = np.where(fb.batting_team_id == 3, \"RR\", np.where(fb.batting_team_id.isin(rcb), \"Champions (RCB)\", \"League\"))\nfb[\"hand\"] = np.where(fb.batting_type == \"LHB\", \"Left-hander\", \"Right-hander\")\nfb[\"btype\"] = np.select([bt[fb.index].str.contains(\"Right-arm\") & bt[fb.index].str.contains(\"medium|ast\"), bt[fb.index].str.contains(\"Left-arm\") & bt[fb.index].str.contains(\"medium|ast\"),\n                         bt[fb.index].str.contains(\"offbreak\"), bt[fb.index].str.contains(\"orthodox\"), bt[fb.index].str.contains(\"Leg-Break\"), bt[fb.index].str.contains(\"Chinaman\")],\n                        [\"Right-arm pace\", \"Left-arm pace\", \"Off-spin\", \"Left-arm finger spin\", \"Leg-spin\", \"Left-arm wrist spin\"], \"other\")\nBT = fb[fb.btype != \"other\"].groupby([\"hand\", \"btype\", \"grp\"]).apply(lambda x: pd.Series({\"balls\": len(x), \"sr\": round(100 * x.runs.sum() / len(x), 1),\n                                                                                       \"per_out\": round(len(x) / max(x.striker_out.sum(), 1), 1)})).reset_index()\nTOP9 = {\"India\", \"England\", \"West Indies\", \"Australia\", \"Sri Lanka\", \"South Africa\", \"Afghanistan\", \"New Zealand\", \"Pakistan\"}; tid = set(t[t.team_name.isin(TOP9)].team_id)\nq = b[(b.year >= 2025) & b.faced & ((b.fmt == \"IPL\") | (b.batting_team_id.isin(tid) & b.bowling_team_id.isin(tid)))].copy(); bq = q.bowling_type.fillna(\"\")\nq[\"type\"] = np.select([bq.str.contains(\"Leg-Break|Chinaman\"), bq.str.contains(\"offbreak|orthodox\"), bq.str.contains(\"medium|ast\")], [\"Wrist spin\", \"Finger spin\", \"Pace\"], \"other\")\nq = q[(q.legal_before // 6).between(6, 14) & (q.type != \"other\")]\nts = []\nfor n, g in [(\"League\", None)] + [(n, \"Target\") for n in TB] + [(n, \"RR now\") for n in [\"Riyan Parag\", \"Dhruv Jurel\", \"Yashasvi Jaiswal\", \"Ravindra Jadeja\"]]:\n    x = q if g is None else q[q.striker_name == n]\n    for ty, y in x.groupby(\"type\"):\n        if len(y) >= 15: ts.append({\"who\": n, \"group\": g or \"League\", \"type\": ty, \"balls\": len(y), \"sr\": round(100 * y.runs.sum() / len(y), 1), \"per_out\": round(len(y) / max(y.striker_out.sum(), 1), 1)})\nTS = pd.DataFrame(ts)\ndef dump(name, df, inputs):\n    rws = json.loads(df.replace({np.nan: None}).to_json(orient=\"records\"))\n    (O / f\"{name}.json\").write_text(json.dumps({\"rows\": rws, \"meta\": [{\"label\": \"s43_verify.py\", \"value\": CODE, \"type\": \"code\", \"lang\": \"python\"}, {\"label\": \"Input\", \"value\": inputs}]}))\n    print(name, len(rws))\ndump(\"area_stats\", A, \"moment_balls_*.parquet (s38), squads2027.csv\"); dump(\"type_phase\", TP, \"balls_pi.parquet, IPL 2025-26\")\ndump(\"bat_types\", BT, \"balls_pi.parquet, IPL 2025-26\"); dump(\"target_spin\", TS, \"balls_pi.parquet, IPL + top-nine T20Is 2025-26, overs 7-15\")\n", "type": "code", "lang": "python"}, {"label": "Input", "value": "moment_balls_*.parquet (s38), squads2027.csv"}]}